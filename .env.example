# ==============================================================================
# ThinkBuddy Environment Configuration (.env.example)
# Copy this to .env for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Core Service Configuration
CORE_HOST=0.0.0.0
CORE_PORT=8001
CORE_INTERNAL_URL=http://localhost:8001

# Shared Internal Service-to-Service Secret
# Used by Gateway to authenticate internal calls to Core
INTERNAL_SERVICE_TOKEN=dev_internal_service_token_placeholder_change_in_production

# PostgreSQL Database (pgvector enabled)
DATABASE_URL=postgresql+asyncpg://thinkbuddy:thinkbuddy_dev_password@localhost:5432/thinkbuddy

# Redis Cache and Queue
REDIS_URL=redis://localhost:6379/0

# Storage (Generic S3 Interface - Cloudflare R2 / AWS S3 in prod, Silo in dev)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minio_dev_access_key
S3_SECRET_ACCESS_KEY=minio_dev_secret_key
S3_BUCKET_NAME=thinkbuddy-content
S3_REGION=auto
S3_USE_SSL=false

# Local S3-compatible Store Credentials (pgsty/silo)
MINIO_ROOT_USER=minio_dev_access_key
MINIO_ROOT_PASSWORD=minio_dev_secret_key

# Offsite Disaster Recovery Storage (Separate provider or region, separate credentials)
# In production, offsite backups replicate to a different cloud provider or geographical region (e.g. R2 eu-central-1)
OFFSITE_BACKUP_PROVIDER=s3
OFFSITE_BACKUP_ENDPOINT_URL=http://localhost:9000
OFFSITE_BACKUP_ACCESS_KEY_ID=minio_dev_access_key
OFFSITE_BACKUP_SECRET_ACCESS_KEY=minio_dev_secret_key
OFFSITE_BACKUP_BUCKET_NAME=thinkbuddy-backups-offsite
OFFSITE_BACKUP_REGION=eu-central-1
OFFSITE_BACKUP_USE_SSL=false
BACKUP_ENCRYPTION_KEY=thinkbuddy_secure_backup_key_32b!

# Security & Encryption Keys
QUESTION_KEY_ENCRYPTION_KEY=dev_question_key_aes_gcm_32bytes_secret_key!
EXPORT_ENCRYPTION_KEY=dev_export_aes_gcm_32bytes_encryption_key!

# OpenTelemetry Observability
OTEL_SERVICE_NAME=thinkbuddy
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=false

# Decoupled RAG & Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=thinkbuddy_books_hybrid
SYLLABUS_INDEX_PATH=data/syllabus_index.json

# Multi-Provider LLM API Keys (Gemini, DeepSeek, Claude)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIBE_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Puck
VOICE_MAX_AUDIO_BYTES=10485760
NGROK_DOMAIN=

# Production VPS & Caddy HTTPS
API_DOMAIN=
ACME_EMAIL=
POSTGRES_USER=thinkbuddy
POSTGRES_PASSWORD=
POSTGRES_DB=thinkbuddy
