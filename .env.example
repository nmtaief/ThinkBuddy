# ==============================================================================
# ThinkBuddy Environment Configuration (.env.example)
# Copy this to .env for local development. Never commit real secrets.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Core Service Configuration
CORE_HOST=0.0.0.0
CORE_PORT=8001
CORE_INTERNAL_URL=http://localhost:8001

# Shared Internal Service-to-Service Secret
# Used by Gateway to authenticate internal calls to Core
INTERNAL_SERVICE_TOKEN=dev_internal_service_token_placeholder_change_in_production

# PostgreSQL Database (pgvector enabled)
DATABASE_URL=postgresql+asyncpg://thinkbuddy:thinkbuddy_dev_password@localhost:5432/thinkbuddy

# Redis Cache and Queue
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO / S3 Stand-in)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_dev_access_key
MINIO_SECRET_KEY=minio_dev_secret_key
MINIO_BUCKET=thinkbuddy-content
MINIO_USE_SSL=false

# OpenTelemetry Observability
OTEL_SERVICE_NAME=thinkbuddy
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLED=false
