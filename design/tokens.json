{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ThinkBuddy Design Tokens",
  "version": "1.0.0",
  "breakpoints": {
    "compact": {
      "min": 0,
      "max": 599,
      "description": "Phone viewports (<600px). Single pane layout with bottom navigation."
    },
    "medium": {
      "min": 600,
      "max": 839,
      "description": "Small tablets and large phones in landscape (600-839px). Navigation rail, optional 2-pane."
    },
    "expanded": {
      "min": 840,
      "max": null,
      "description": "Tablets and desktops (>=840px). Navigation sidebar, 2-3 pane layouts, capped container width (1280px)."
    }
  },
  "colors": {
    "light": {
      "primary": "#2563EB",
      "primaryHover": "#1D4ED8",
      "primarySurface": "#EFF6FF",
      "secondary": "#0D9488",
      "secondaryHover": "#0F766E",
      "secondarySurface": "#F0FDFA",
      "background": "#F8FAFC",
      "surface": "#FFFFFF",
      "surfaceHover": "#F1F5F9",
      "surfaceElevated": "#FFFFFF",
      "border": "#E2E8F0",
      "borderFocused": "#3B82F6",
      "text": {
        "primary": "#0F172A",
        "secondary": "#475569",
        "muted": "#64748B",
        "inverse": "#FFFFFF"
      },
      "feedback": {
        "success": "#16A34A",
        "successSurface": "#DCFCE7",
        "needsPractice": "#D97706",
        "needsPracticeSurface": "#FEF3C7",
        "notEnoughData": "#64748B",
        "notEnoughDataSurface": "#F1F5F9",
        "warning": "#EA580C",
        "warningSurface": "#FFEDD5",
        "danger": "#DC2626",
        "dangerSurface": "#FEE2E2",
        "info": "#0284C7",
        "infoSurface": "#E0F2FE"
      },
      "dayTypes": {
        "schoolDay": "#3B82F6",
        "holiday": "#10B981",
        "blackout": "#94A3B8",
        "examDay": "#8B5CF6"
      }
    },
    "dark": {
      "primary": "#3B82F6",
      "primaryHover": "#60A5FA",
      "primarySurface": "#1E293B",
      "secondary": "#14B8A6",
      "secondaryHover": "#2DD4BF",
      "secondarySurface": "#132A27",
      "background": "#0B0F19",
      "surface": "#111827",
      "surfaceHover": "#1F2937",
      "surfaceElevated": "#1E293B",
      "border": "#1F2937",
      "borderFocused": "#60A5FA",
      "text": {
        "primary": "#F9FAFB",
        "secondary": "#CBD5E1",
        "muted": "#94A3B8",
        "inverse": "#0F172A"
      },
      "feedback": {
        "success": "#22C55E",
        "successSurface": "#143823",
        "needsPractice": "#F59E0B",
        "needsPracticeSurface": "#3D2B05",
        "notEnoughData": "#94A3B8",
        "notEnoughDataSurface": "#1E293B",
        "warning": "#F97316",
        "warningSurface": "#3E1E09",
        "danger": "#EF4444",
        "dangerSurface": "#3F1515",
        "info": "#38BDF8",
        "infoSurface": "#0C2E42"
      },
      "dayTypes": {
        "schoolDay": "#60A5FA",
        "holiday": "#34D399",
        "blackout": "#64748B",
        "examDay": "#A78BFA"
      }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "full": "9999px"
  },
  "typography": {
    "fontFamilies": {
      "bangla": "'Noto Sans Bengali', 'Hind Siliguri', system-ui, sans-serif",
      "english": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
      "math": "'KaTeX_Main', 'KaTeX_Math', 'Times New Roman', serif"
    },
    "fontSizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px",
      "4xl": "36px"
    },
    "lineHeights": {
      "none": "1",
      "tight": "1.25",
      "snug": "1.375",
      "normal": "1.5",
      "relaxed": "1.625",
      "loose": "2"
    },
    "fontWeights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "elevations": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
  },
  "touchTarget": {
    "minSize": "48px",
    "accessibilityStandard": "WCAG 2.1 Level AAA (target size) / Android 48dp / iOS 44pt"
  }
}
