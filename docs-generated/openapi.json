  "components": {
    "schemas": {
      "AddChildRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "description": "Student's name (Bangla or English)"
          },
          "class_level": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 6.0,
            "title": "Class Level",
            "description": "Class level (6-8)"
          },
          "medium": {
            "type": "string",
            "title": "Medium",
            "description": "Medium: bn or en",
            "default": "bn"
          },
          "school": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "School",
            "description": "School name"
          },
          "daily_minutes": {
            "type": "integer",
            "maximum": 180.0,
            "minimum": 15.0,
            "title": "Daily Minutes",
            "description": "Daily study target",
            "default": 45
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "class_level"
        ],
        "title": "AddChildRequest"
      },
      "AddChildResponse": {
        "properties": {
          "student_id": {
            "type": "string",
            "format": "uuid",
            "title": "Student Id"
          },
          "link_code": {
            "type": "string",
            "title": "Link Code"
          },
          "link_id": {
            "type": "string",
            "format": "uuid",
            "title": "Link Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "link_code",
          "link_id",
          "expires_at"
        ],
        "title": "AddChildResponse"
      },
      "AuthExchangeRequest": {
        "properties": {
          "provider_token": {
            "type": "string",
            "title": "Provider Token",
            "description": "Firebase ID token or test token"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Role: student or parent",
            "default": "student"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name",
            "description": "User full name (Bangla/English)"
          },
          "locale": {
            "type": "string",
            "title": "Locale",
            "description": "Preferred locale: bn or en",
            "default": "bn"
          },
          "class_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Class Level",
            "description": "Class level (6-8) for students"
          },
          "medium": {
            "type": "string",
            "title": "Medium",
            "description": "Medium: bn or en",
            "default": "bn"
          }
        },
        "type": "object",
        "required": [
          "provider_token"
        ],
        "title": "AuthExchangeRequest"
      },
      "CreateFamilyRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Family name (e.g. 'রহমান পরিবার' or 'Rahman Family')"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateFamilyRequest"
      },
      "DeviceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "form_factor": {
            "type": "string",
            "title": "Form Factor"
          },
          "app_version": {
            "type": "string",
            "title": "App Version"
          },
          "push_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Push Token"
          },
          "integrity_status": {
            "type": "string",
            "title": "Integrity Status"
          },
          "last_seen_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Seen At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_id",
          "platform",
          "form_factor",
          "app_version",
          "integrity_status",
          "last_seen_at"
        ],
