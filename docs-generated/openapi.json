    "/v1/client/config": {
      "get": {
        "tags": [
          "Client & Config"
        ],
        "summary": "Get Client Config",
        "description": "Dynamic client configuration endpoint per docs/04_API_CONTRACT.md §1 & §5.\n\nReturns server-driven settings, minimum version thresholds, active feature flags,\nand quiz security modes allowed per platform without code branching.",
        "operationId": "get_client_config_v1_client_config_get",
        "parameters": [
          {
            "name": "X-Client-Platform",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "android",
              "title": "X-Client-Platform"
            }
          },
          {
            "name": "X-Client-Form-Factor",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "phone",
              "title": "X-Client-Form-Factor"
            }
          },
          {
            "name": "X-App-Version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "0.1.0",
              "title": "X-App-Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Client Config V1 Client Config Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
