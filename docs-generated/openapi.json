            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "owner_parent_id": {
            "type": "string",
            "format": "uuid",
            "title": "Owner Parent Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
