            "title": "Student Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "class_level": {
            "type": "integer",
            "title": "Class Level"
          },
          "medium": {
            "type": "string",
            "title": "Medium"
          },
          "school": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "School"
          },
          "daily_minutes": {
            "type": "integer",
            "title": "Daily Minutes"
          },
          "link_id": {
            "type": "string",
            "format": "uuid",
            "title": "Link Id"
          },
          "linked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
